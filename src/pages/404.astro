---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not Found">
  <div class="py-20 text-center">
    <h1 class="mb-4 text-6xl font-bold" style="color: var(--brand-primary);">404</h1>
    <p class="mb-8 text-lg" style="color: var(--brand-muted);">Page not found.</p>
    <a
      href="/"
      class="rounded-lg px-6 py-3 text-sm font-medium text-white"
      style="background-color: var(--brand-primary);"
    >
      Go home
    </a>
  </div>
</BaseLayout>
