---
interface Props {
  tags: string[];
  class?: string;
}

const { tags, class: className } = Astro.props;
---

<div class:list={["flex flex-wrap gap-2", className]}>
  {
    tags.map((tag) => (
      <a
        href={`/tags/${tag}`}
        class="rounded-full px-3 py-1 text-xs font-medium transition-colors"
        style="background-color: var(--brand-surface); color: var(--brand-muted); border: 1px solid var(--brand-border);"
      >
        {tag}
      </a>
    ))
  }
</div>
